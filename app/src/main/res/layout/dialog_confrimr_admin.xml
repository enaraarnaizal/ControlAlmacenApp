<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvTituloAdmin"
        android:text="Verificación de Administrador"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvSubtituloAdmin"
        android:text="Para acceder a Perfiles, introduce tu contraseña de administrador."
        android:textSize="14sp"
        android:textColor="#475569"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etPassAdmin"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:background="@drawable/bg_input_admin"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnCancelar"
            android:text="Cancelar"
            android:textColor="#475569"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnConfirmar"
            android:text="Verificar"
            android:textColor="@android:color/white"
            android:backgroundTint="#F97316"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
