<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#DDEFE3"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gestión de Albaranes"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCerrarAlbaran"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Filtros -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtros:"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroMes"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="Mes Actual"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#16C55F"
                    android:textColor="#FFFFFF"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="Semana Actual"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#ECECEC"
                    android:textColor="#111827"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroRango"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="Rango Personalizado"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#ECECEC"
                    android:textColor="#111827"
                    app:strokeWidth="0dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Rango -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutRangoFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#D8DEE6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha inicio"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFechaInicio"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="Seleccionar"
                            android:textAllCaps="false"
                            android:textColor="#111827"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#F3F4F6"
                            app:strokeColor="#D8DEE6"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha fin"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFechaFin"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="Seleccionar"
                            android:textAllCaps="false"
                            android:textColor="#111827"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#F3F4F6"
                            app:strokeColor="#D8DEE6"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAplicarRango"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="Aplicar filtro"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#16C55F" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Texto del filtro -->
        <TextView
            android:id="@+id/tvFiltroActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Mostrando: Mes actual"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- Acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabNuevoAlbaran"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:text="+  Nuevo Albarán"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="#16C55F" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerarInforme"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Generar Informe"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                app:cornerRadius="14dp"
                app:backgroundTint="#E5E7EB" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeleccionarTodos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:text="Seleccionar todos"
            android:textAllCaps="false"
            android:textColor="#64748B"
            android:textSize="12sp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            app:rippleColor="#22000000" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#D8DEE6" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlbaranes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

</LinearLayout>