<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/white">

        <!-- ✅ Vertical: contenido con scroll + botones fijos abajo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ✅ SCROLL -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <!-- Título -->
                    <TextView
                        android:id="@+id/tvTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Añadir Producto"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnCerrar"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Cerrar (X) -->
                    <ImageButton
                        android:id="@+id/btnCerrar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:contentDescription="Cerrar"
                        app:tint="#111827"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Separador -->
                    <View
                        android:id="@+id/sep1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Label foto -->
                    <TextView
                        android:id="@+id/tvFotoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Foto del Producto "
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/sep1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvFotoReq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textStyle="bold"
                        android:textColor="#EF4444"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvFotoLabel"
                        app:layout_constraintStart_toEndOf="@id/tvFotoLabel" />

                    <!-- Zona foto punteada -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFoto"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F3F4F6"
                        app:layout_constraintTop_toBottomOf="@id/tvFotoLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dashed_area"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:contentDescription="Camara"
                                    app:tint="#9CA3AF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sin foto"
                                    android:layout_marginTop="8dp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Botones tomar/subir -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTomarFoto"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="Tomar Foto"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconPadding="8dp"
                        android:backgroundTint="#2563EB"
                        android:textColor="@android:color/white"
                        app:cornerRadius="14dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/cardFoto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnSubirFoto"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubirFoto"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="Subir Foto"
                        app:icon="@android:drawable/ic_menu_upload"
                        app:iconPadding="8dp"
                        android:backgroundTint="#6B7280"
                        android:textColor="@android:color/white"
                        app:cornerRadius="14dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/cardFoto"
                        app:layout_constraintStart_toEndOf="@id/btnTomarFoto"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="8dp" />

                    <!-- Nombre -->
                    <TextView
                        android:id="@+id/tvNombreLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nombre del Producto *"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/btnTomarFoto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNombreLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ej: Tomates"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Cantidad -->
                    <TextView
                        android:id="@+id/tvCantidadLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Cantidad *"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tilNombre"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCantidad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCantidadLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCantidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ej: 10"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mínimo -->
                    <TextView
                        android:id="@+id/tvMinLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Cantidad Mínima (opcional)"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tilCantidad"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvMinLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ej: 5"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Checkbox -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDeshabilitado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardBackgroundColor="#F3F4F6"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tilMin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="14dp"
                            android:gravity="center_vertical">

                            <CheckBox
                                android:id="@+id/cbDeshabilitado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Producto Deshabilitado"
                                    android:textStyle="bold"
                                    android:textColor="#111827" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Para productos de temporada o que ya no se sirven"
                                    android:textColor="#6B7280"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Espacio extra -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        app:layout_constraintTop_toBottomOf="@id/cardDeshabilitado"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ✅ BOTONES FIJOS -->
            <LinearLayout
                android:id="@+id/rowBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:background="@android:color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textColor="#111827"
                    android:backgroundTint="#F3F4F6"
                    app:cornerRadius="14dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Añadir Producto"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#2563EB"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>